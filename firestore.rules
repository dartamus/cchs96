rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /publicProfiles/{profileId} {
      allow read: if true;
      allow write: if false;
    }

    match /profileSubmissions/{submissionId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasAll(['first','last','current','city','bio','email','phone','contactVisibility','updates','status','submittedAt']) &&
        request.resource.data.keys().hasOnly(['first','last','current','city','bio','email','phone','contactVisibility','updates','status','submittedAt']) &&
        request.resource.data.first is string && request.resource.data.first.size() > 0 && request.resource.data.first.size() <= 80 &&
        request.resource.data.last is string && request.resource.data.last.size() > 0 && request.resource.data.last.size() <= 80 &&
        request.resource.data.current is string && request.resource.data.current.size() <= 80 &&
        request.resource.data.city is string && request.resource.data.city.size() <= 120 &&
        request.resource.data.bio is string && request.resource.data.bio.size() <= 2000 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 40 &&
        request.resource.data.contactVisibility is string && request.resource.data.contactVisibility.size() <= 40 &&
        request.resource.data.updates is string && request.resource.data.updates.size() <= 40 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.submittedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
